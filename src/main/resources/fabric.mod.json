{
  "schemaVersion": 1,
  "id": "ctc",
  "version": "${version}",
  "name": "Tweaked Controllers",
  "description": "A Create addon that adds a way of controlling contraptions using an advanced controller. Fabric port of Create: Tweaked Controllers by getItemFromBlock, forked and ported by Firepdx.",
  "authors": [
    "getItemFromBlock (original NeoForge mod)",
    "Firepdx (Fabric port)"
  ],
  "contact": {
    "homepage": "https://github.com/getItemFromBlock/Create-Tweaked-Controllers",
    "sources": "https://github.com/getItemFromBlock/Create-Tweaked-Controllers",
    "issues": "https://github.com/getItemFromBlock/Create-Tweaked-Controllers/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.firepdx.ctc.CreateTweakedControllers"
    ],
    "client": [
      "com.firepdx.ctc.client.CreateTweakedControllersClient"
    ],
    "modmenu": [
      "com.firepdx.ctc.client.CtcModMenuIntegration"
    ]
  },
  "mixins": [
    "ctc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "create": ">=6.0.0"
  },
  "suggests": {
    "computercraft": "*",
    "modmenu": "*"
  }
}
